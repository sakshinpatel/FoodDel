# CraveKart Backend Environment Variables Template
# Copy this file to .env in this directory

JWT_SECRET=your_jwt_secret_key_here
SALT=10
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cravekart?retryWrites=true&w=majority
