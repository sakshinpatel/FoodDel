# CraveKart Backend Environment Variables Template
# Copy this file to backend/.env and replace placeholders with your actual values

# JSON Web Token Secret Key used for authentication
JWT_SECRET=your_jwt_secret_key_here

# Bcrypt salt rounds (numeric integer, typically 10)
SALT=10

# MongoDB Connection String (Atlas URI or local mongodb://127.0.0.1:27017/cravekart)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cravekart?retryWrites=true&w=majority

# Stripe Secret Key for payments (starts with sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Port for backend server (defaults to 4000)
PORT=4000

# Frontend URL for Stripe redirect callbacks (e.g. http://localhost:5173 in dev)
FRONTEND_URL=http://localhost:5173
